# ---------------------------------------------------------------------------
# market-terminal configuration
# Copy to `.env` (which is gitignored) and fill in whatever you have.
# The app runs with ZERO keys — it falls back to the keyless sources.
# Every key you add widens the rate budget and adds a failover path.
# ---------------------------------------------------------------------------

# --- Multiple keys per provider -------------------------------------------
# Three accepted spellings; use whichever keeps your file readable.
#
#   MKT_FINNHUB_KEYS=key1,key2,key3     comma-separated list
#   MKT_FINNHUB_KEY=key1                a single key
#   MKT_FINNHUB_KEY_1=key1              numbered, any count up to 50
#   FINNHUB_API_KEY=key1                bare vendor-style name
#
# Keys are pooled per provider, rotated least-recently-used, and each one
# carries its own rate budget. Placeholder values starting with "your_" are
# ignored, so the lines below are safe to leave as they are.

# finnhub.io — 60 calls/min per key. Best free quote source.
MKT_FINNHUB_KEYS=your_finnhub_key_1,your_finnhub_key_2

# alphavantage.co — 5 calls/min AND 25 calls/day per key.
# The daily cap is why rotation matters here: 8 keys = 200 calls/day.
MKT_ALPHAVANTAGE_KEYS=your_av_key_1,your_av_key_2,your_av_key_3

# twelvedata.com — 8 calls/min, 800/day per key.
MKT_TWELVEDATA_KEYS=your_twelvedata_key

# polygon.io — 5 calls/min, 15-minute delayed on the free tier.
MKT_POLYGON_KEYS=your_polygon_key

# financialmodelingprep.com — 250 calls/day per key.
MKT_FMP_KEYS=your_fmp_key

# tiingo.com — 50 calls/hour, 500/day per key.
MKT_TIINGO_KEYS=your_tiingo_key

# marketstack.com — 100 calls/month on free; keep it as a last resort.
MKT_MARKETSTACK_KEYS=your_marketstack_key

# fred.stlouisfed.org — macro series (DGS10, CPIAUCSL, UNRATE, FEDFUNDS).
MKT_FRED_KEYS=your_fred_key

# newsapi.org — 100 requests/day on the free tier.
MKT_NEWSAPI_KEYS=your_newsapi_key

# --- Scraper identity -------------------------------------------------------
# SEC EDGAR REQUIRES a contact address in the User-Agent and will block you
# without one. This is not optional if you want filings to work.
MKT_CONTACT_EMAIL=you@example.com
# MKT_USER_AGENT=market-terminal/1.0 (you@example.com)

# Honour robots.txt on scraped hosts. Leave this on.
MKT_RESPECT_ROBOTS=1

# --- Behaviour --------------------------------------------------------------
MKT_WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,SPY
MKT_QUOTE_REFRESH=15        # seconds between watchlist refreshes
MKT_NEWS_REFRESH=120
MKT_STALE_AFTER=90          # a quote older than this is highlighted yellow
MKT_CACHE_TTL=20            # response cache lifetime, seconds
MKT_HTTP_TIMEOUT=12
MKT_MAX_RETRIES=3
# MKT_OFFLINE=1             # block all outbound calls (useful for demos)
